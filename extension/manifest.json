{
  "manifest_version": 3,
  "name": "FreeDM Integration",
  "version": "1.0",
  "description": "يرسل التحميلات من المتصفح إلى برنامج FreeDM على جهازك.",
  "permissions": [
    "downloads",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}